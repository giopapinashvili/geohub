rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── CORE HELPERS ──────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isOwner(userId) {
      return signedIn() && uid() == userId;
    }
    // friendships/{id} where id = sorted([uidA, uidB]).join('_')
    function friendPairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(friendPairId(a, b)));
    }
    // A friend request is stored at friendRequests/{fromUid}_{toUid}, so an
    // accepted request in either direction is checkable without a query.
    function friendRequestAccepted(a, b) {
      return (exists(/databases/$(database)/documents/friendRequests/$(a + '_' + b))
              && get(/databases/$(database)/documents/friendRequests/$(a + '_' + b)).data.get('status','') == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(b + '_' + a))
              && get(/databases/$(database)/documents/friendRequests/$(b + '_' + a)).data.get('status','') == 'accepted');
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── VISIBILITY HELPERS ───────────────────────────────────────────────────
    // A friendship can live in either collection the app has written.
    function areFriendsAny(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(friendPairId(a, b)))
          || exists(/databases/$(database)/documents/friends/$(friendPairId(a, b)));
    }
    // follows/{followerId}_{followingId}
    function isFollowing(a, b) {
      return exists(/databases/$(database)/documents/follows/$(a + '_' + b));
    }
    // Who may read a post (d = the post's data). Rules are not filters: every
    // query on posts must carry a constraint that proves one of these branches
    // (visibility == 'public', authorId == me, audienceIds/closeFriendIds
    // array-contains me, …). The audience lists are written by the author.
    // Every default below is the restrictive one: when a query leaves a field
    // unconstrained, the rules engine evaluates get(field, default) with the
    // default, so a default of 'public' would let an unfiltered query read
    // every post. Posts without a visibility field are therefore not public
    // (the privacy migration gives every post one).
    function canReadPostData(d) {
      return d.get('visibility', '') == 'public'
        || (d.get('visibility', '') == 'group' && isGroupMember(d.get('groupId', '')))
        || (signedIn() && (
             d.get('authorId', '') == uid()
          || d.get('userId', '') == uid()
          || uid() in d.get('audienceIds', [])
          || uid() in d.get('closeFriendIds', [])
          || (d.get('visibility', '') == 'friends'
              && areFriendsAny(uid(), d.get('authorId', d.get('userId', ''))))
          || (d.get('visibility', '') == 'followers'
              && (isFollowing(uid(), d.get('authorId', d.get('userId', '')))
                  || areFriendsAny(uid(), d.get('authorId', d.get('userId', '')))))
          || isAdmin()
        ));
    }
    function canReadPostId(postId) {
      return canReadPostData(get(/databases/$(database)/documents/posts/$(postId)).data);
    }

    // Caller's UID appears in at least one standard ownership field of the
    // document being created. Used for create-only guards.
    function newOwnerMatches() {
      return signedIn() && (
        request.resource.data.get('userId',    '') == uid() ||
        request.resource.data.get('authorId',  '') == uid() ||
        request.resource.data.get('uid',       '') == uid() ||
        request.resource.data.get('createdBy', '') == uid() ||
        request.resource.data.get('ownerId',   '') == uid()
      );
    }

    // Caller owns the existing document being read/updated/deleted.
    function existingOwnerMatches() {
      return signedIn() && (
        resource.data.get('userId',    '') == uid() ||
        resource.data.get('authorId',  '') == uid() ||
        resource.data.get('uid',       '') == uid() ||
        resource.data.get('createdBy', '') == uid() ||
        resource.data.get('ownerId',   '') == uid()
      );
    }

    // ── USER FIELD PROTECTION ─────────────────────────────────────────────────

    // Fields that only Cloud Functions or an admin may write on a user document.
    // Blocks economy inflation, trust manipulation, and privilege escalation.
    // This list must stay in sync with userCreateFieldsSafe() below.
    function userAdminOnlyFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'pointsBalance', 'totalPointsEarned', 'totalPointsSpent',
        'totalPointsTransferred', 'totalPointsReceived',
        'xp', 'level', 'trustScore', 'verified',
        'role', 'isAdmin', 'adminLevel', 'premiumUntil',
        'suspended', 'suspendedAt', 'suspendedBy'
      ]);
    }

    // Validates searchHistory field when it is being modified on a user document.
    // Must be a list of at most 10 items. Does not fire when searchHistory is untouched.
    function searchHistoryValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['searchHistory'])
        // removing it (it moved to users/{uid}/private/account) is fine
        || !request.resource.data.keys().hasAny(['searchHistory'])
        || (request.resource.data.searchHistory is list
            && request.resource.data.searchHistory.size() <= 10);
    }

    // On creation a new user document must not include any admin/economy field.
    // Prevents bootstrapping an elevated account before any CF or admin action.
    function userCreateFieldsSafe() {
      return !request.resource.data.keys().hasAny([
        'pointsBalance', 'totalPointsEarned', 'totalPointsSpent',
        'totalPointsTransferred', 'totalPointsReceived',
        'xp', 'level', 'trustScore', 'verified',
        'role', 'isAdmin', 'adminLevel', 'premiumUntil',
        'suspended', 'suspendedAt', 'suspendedBy'
      ]);
    }

    // ── COUNTER HELPERS ───────────────────────────────────────────────────────

    // Social engagement counters updated client-side for MVP.
    // Each counter is bounded to ±1 per write to prevent inflation attacks
    // (e.g. a malicious client setting likeCount=1000000 directly).
    // Full integrity requires Cloud Function triggers (TODO).
    function counterDelta(field) {
      let cur = resource.data.get(field, 0);
      let nxt = request.resource.data.get(field, 0);
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
             || nxt in [cur - 1, cur, cur + 1];
    }
    function onlyCountersChanged() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likeCount', 'commentCount', 'shareCount',
          'reactionCount', 'saveCount', 'viewCount', 'updatedAt'
        ])
        && counterDelta('likeCount')
        && counterDelta('commentCount')
        && counterDelta('shareCount')
        && counterDelta('reactionCount')
        && counterDelta('saveCount')
        && counterDelta('viewCount');
    }

    // Any signed-in user may update story view fields only (no other fields).
    function onlyStoryViewFields() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['viewedBy', 'viewCount', 'updatedAt']);
    }

    // Displaying a page identity never replaces the authenticated creator UID.
    function validContentIdentity(data) {
      return signedIn()
        && data.get('authorId', uid()) == uid()
        && data.get('userId', uid()) == uid()
        && (data.get('authorType', 'user') == 'user'
          || (data.get('authorType', '') == 'business'
            && data.get('businessId', '') is string
            && data.get('businessId', '') != ''
            && canManageBiz(data.businessId)));
    }
    function contentIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'authorId', 'userId', 'authorType', 'businessId', 'createdByUid',
        'authorName', 'authorAvatar', 'createdAt'
      ]);
    }

    // Fields a post owner/business owner may edit after creation.
    function onlyPostManagementFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'text', 'status', 'visibility', 'commentsDisabled',
        'pinned', 'approvedAt', 'declinedAt', 'updatedAt'
      ]);
    }
    // The author may also change who the post is shared with.
    function onlyPostOwnerFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'text', 'status', 'visibility', 'commentsDisabled',
        'pinned', 'approvedAt', 'declinedAt', 'updatedAt',
        'audienceIds', 'closeFriendIds'
      ]);
    }

    // Account data that must never sit in the world-readable users/{uid}
    // document; it lives in users/{uid}/private/account (owner + admin only).
    function privateUserFields() {
      return ['email', 'phone', 'birthday', 'searchHistory'];
    }
    // A write may leave legacy private fields untouched, or remove them all,
    // but never add or change one.
    function privateUserFieldsNotWritten() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(privateUserFields())
        || !request.resource.data.keys().hasAny(privateUserFields());
    }

    function onlyBusinessCountersChanged() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'followerCount', 'postCount', 'reviewCount',
          'ratingAverage', 'ratingTotal', 'ratingCount',
          'viewCount', 'saveCount', 'quoteCount', 'updatedAt'
        ]);
    }
    function onlyChannelCountersChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'subscriberCount', 'videoCount'
      ]) && counterDelta('subscriberCount') && counterDelta('videoCount');
    }

    // Returns true when the requesting user owns the business at bizId.
    // Bind the grant's contents to its ID. Otherwise a manager of business A
    // could create an A grant using B_uid as the document ID and manage B.
    function isBizOwner(bizId) {
      let grant = get(/databases/$(database)/documents/businessAdmins/$(bizId + '_' + request.auth.uid)).data;
      return signedIn() && grant != null && grant.get('businessId', '') == bizId && grant.get('userId', '') == uid();
    }

    // New per-page admin roles live under businesses/{businessId}/admins/{uid}.
    function isBizPageAdmin(bizId) {
      return signedIn()
        && exists(/databases/$(database)/documents/businesses/$(bizId)/admins/$(request.auth.uid));
    }

    // Some older business documents only store ownerId on /businesses/{id}.
    function isBizDocOwner(bizId) {
      return signedIn()
        && get(/databases/$(database)/documents/businesses/$(bizId)).data.get('ownerId', '') == uid();
    }

    function canManageBiz(bizId) {
      // Keep the common owner/admin paths short, leaving access-call budget
      // for item and branch validation in a single commerce write.
      return isAdmin() || isBizDocOwner(bizId) || isBizPageAdmin(bizId) || isBizOwner(bizId);
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid));
    }

    function isGroupManager(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid)).data.get('role', 'member') in ['owner', 'admin', 'moderator'];
    }

    function isGroupOwnerOrAdmin(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid)).data.get('role', 'member') in ['owner', 'admin'];
    }

    // True when the group's privacy field is 'public' (or absent).
    // Used to gate subcollection reads: private/secret group content
    // is only visible to members and admins.
    // If the group document does not exist, get() throws → false (safe deny).
    function isGroupPublic(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.get('privacy', 'public') == 'public';
    }

    // Business owner of the post's business can moderate comments.
    function isBizOwnerOfPost(postId) {
      let bizId = get(/databases/$(database)/documents/posts/$(postId)).data.get('businessId', '');
      return bizId != '' && canManageBiz(bizId);
    }

    // Post author can moderate (delete) comments on their own post.
    function isPostOwner(postId) {
      let p = get(/databases/$(database)/documents/posts/$(postId)).data;
      return signedIn()
        && (p.get('createdByUid', '') == uid()
            || p.get('authorId',   '') == uid()
            || p.get('userId',     '') == uid());
    }

    function isGroupManagerOfPost() {
      let groupId = resource.data.get('groupId', resource.data.get('targetId', ''));
      return groupId != '' && resource.data.get('targetType', '') == 'group' && isGroupManager(groupId);
    }

    // Comment author may only change text/updatedAt on their own comments.
    function onlyCommentTextChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['text', 'updatedAt', 'edited', 'editedAt']);
    }

    function onlyCommentCountersChanged() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reactionCount', 'replyCount', 'updatedAt']);
    }

    function onlyCommentSoftDeleteChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'updatedAt'])
        && request.resource.data.get('status', '') in ['active', 'deleted'];
    }

    function onlyPollChanged() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['poll', 'updatedAt']);
    }

    function onlyBusinessReviewCountersChanged() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reportCount', 'reported', 'updatedAt']);
    }

    function onlyBusinessOwnerReplyChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['ownerReply', 'updatedAt']);
    }

    function onlyMessageParticipantMetaChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['likedBy', 'deletedFor', 'deletedForActors', 'seenBy', 'readBy', 'seenByActors', 'readByActors', 'delivered', 'reactions', 'updatedAt']);
    }

    function onlyMessageSenderEditChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'text', 'body', 'message', 'content',
          'edited', 'editedAt', 'deleted', 'deletedBy', 'deletedAt',
          'deletedForEveryone', 'deletedByActorId',
          'status', 'updatedAt',
          'mediaUrl', 'mediaType', 'imageUrl', 'fileName', 'fileSize',
          'attachment', 'attachments', 'replyTo'
        ]);
    }

    function onlyConversationSettingsOwner() {
      return signedIn()
        && request.resource.data.get('userId', '') == uid()
        && request.resource.data.keys().hasOnly([
             'userId', 'conversationId', 'archived', 'mutedUntil', 'theme', 'nickname', 'updatedAt'
           ]);
    }

    function onlyGroupCountersChanged() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberCount', 'postCount', 'updatedAt'
        ]);
    }

    // Reads the conversation doc to verify participant membership.
    // Phase 57: also checks memberUids (canonical) in addition to participants (legacy).
    // Also grants access when the caller is the business owner/customer on a forBusiness conv.
    function isConversationParticipant(conversationId) {
      let convData = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && (uid() in convData.get('participants', [])
            || uid() in convData.get('memberUids', [])
            || (convData.get('forBusiness', false) == true
                && (convData.get('ownerUid', '') == uid()
                    || convData.get('customerUid', '') == uid())));
    }

    function validNewBusinessConversation(data) {
      let business = get(/databases/$(database)/documents/businesses/$(data.get('businessId', ''))).data;
      let customer = data.get('customerUid', '');
      let owner = data.get('ownerUid', '');
      return business != null && customer == uid() && owner != customer
        && owner == business.get('ownerId', business.get('createdBy', business.get('userId', '')))
        && data.get('participants', []).size() == 2
        && data.participants.hasAll([customer, owner])
        && data.get('memberUids', []).size() == 2
        && data.memberUids.hasAll([customer, owner])
        && data.get('inboxActorIds', []).size() == 2
        && data.inboxActorIds.hasAll(['user_' + customer, 'business_' + data.businessId]);
    }
    function conversationIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'participants', 'memberUids', 'forBusiness', 'businessId', 'ownerUid', 'customerUid',
        'inboxActorIds', 'inboxKeys', 'customerActorId', 'pageActorId', 'type'
      ]);
    }
    function validMessageIdentity(conversationId, data) {
      let conversation = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      let actorId = data.get('senderActorId', 'user_' + uid());
      let type = data.get('senderActorType', actorId.matches('^business[_:].*') ? 'business' : 'user');
      return data.get('senderId', '') == uid()
        && data.get('authorId', uid()) == uid() && data.get('performedByUid', uid()) == uid()
        && ((type == 'user'
            && actorId in ['user_' + uid(), 'user:' + uid()]
            && data.get('senderActorKey', 'user:' + uid()) == 'user:' + uid())
          || (type == 'business' && conversation.get('forBusiness', false) == true
            && conversation.get('businessId', '') is string
            && actorId in ['business_' + conversation.businessId, 'business:' + conversation.businessId]
            && data.get('senderActorKey', 'business:' + conversation.businessId) == 'business:' + conversation.businessId
            && canManageBiz(conversation.businessId)));
    }

    // ── USERS ─────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if true;

      // Create: must be own document; must not pre-set economy or admin fields
      // (those are initialised by Cloud Functions on first sign-in).
      allow create: if isOwner(userId) && userCreateFieldsSafe()
        && !request.resource.data.keys().hasAny(privateUserFields());

      // Update: owner may edit display/bio fields but never economy or admin
      // fields.  Admin may change anything.  searchHistory must be a list ≤10.
      allow update: if (isOwner(userId) && userAdminOnlyFields() && searchHistoryValid()
                         && privateUserFieldsNotWritten())
        || isAdmin();

      allow delete: if isAdmin();

      // ── Challenge progress ──────────────────────────────────────────────────
      // Client writes are allowed for MVP because moving this to Cloud Functions
      // is a significant refactor.  The rules enforce a ratchet (count/progress
      // can only increase) and immutability of the completed/xpAwarded flags.
      //
      // TODO: For full XP integrity, trigger a Cloud Function on checkin creates
      // that owns all progress writes and makes these rules read-only for owner.
      match /challengeProgress/{challengeId} {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && (request.resource.data.get('userId', '') == userId
              || request.resource.data.get('uid', '') == userId)
          && request.resource.data.get('challengeId', '') == challengeId
          && request.resource.data.get('count', 0) is number
          && request.resource.data.get('progress', 0) is number;

        allow update: if isOwner(userId)
          // Ownership fields must not change
          && (resource.data.get('userId', '') == userId
              || resource.data.get('uid', '') == userId)
          && (request.resource.data.get('userId', '') == userId
              || request.resource.data.get('uid', '') == userId)
          && request.resource.data.get('challengeId', '') == challengeId
          // Ratchet: count and progress may only increase
          && request.resource.data.get('count',    0) >= resource.data.get('count',    0)
          && request.resource.data.get('progress', 0) >= resource.data.get('progress', 0)
          // These two flags are immutable once set true
          && !(resource.data.get('completed',  false) == true
               && request.resource.data.get('completed',  false) != true)
          && !(resource.data.get('xpAwarded',  false) == true
               && request.resource.data.get('xpAwarded',  false) != true);

        allow delete: if isAdmin();

        match /sources/{sourceId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId);
          allow delete: if isAdmin();
        }
      }

      // ── Badges (sub-collection) ─────────────────────────────────────────────
      // Owner may create their own badge documents (needed for current client
      // award flow after challenge completion).  Field validation prevents
      // self-granting special/rarity flags.  Updates are admin-only so that a
      // badge cannot be upgraded after award.
      //
      // TODO: Move badge creation to a Cloud Function triggered by
      // challengeProgress completions; then change create to admin-only here.
      match /badges/{badgeId} {
        allow read: if true;

        allow create: if isOwner(userId)
          && request.resource.data.get('userId',  '') == userId
          && request.resource.data.get('badgeId', '') == badgeId
          // Prevent self-granting privilege flags
          && !request.resource.data.keys().hasAny([
               'adminGranted', 'special', 'grantedBy'
             ]);

        // Updates are admin-only: no post-hoc badge inflation.
        allow update, delete: if isAdmin();
      }

      match /checkins/{placeId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isAdmin();
      }
      match /moodTagVotes/{placeId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isAdmin();
      }
      // The wallet holds the GeoPoints balance. It used to fall under the
      // generic /private rule below, which let its owner write it — so a user
      // could set their own credits from the console, defeating the careful
      // pointsBalance lock on the parent user document. It is now read-only to
      // its owner; only the Admin SDK (a Cloud Function) may write it.
      match /private/wallet    { allow read: if isOwner(userId) || isAdmin(); }
      match /private/{docId}   {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if (isOwner(userId) && docId != 'wallet') || isAdmin();
      }
      match /preferences/{prefId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /fcmTokens/{token} {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // ── Life Events sub-collection ────────────────────────────────────────
      match /lifeEvents/{eventId} {
        allow read: if true;
        allow create: if isOwner(userId)
          && request.resource.data.get('label', '') is string
          && request.resource.data.get('label', '').size() > 0;
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /workHistory/{businessId} {
        allow read: if true;
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /highlights/{hlId} {
        allow read: if true;
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /storyArchive/{storyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /closeFriends/{friendUid} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Admin UIDs are set manually in the Firebase Console.
    // No public API must ever allow a user to write here.
    match /admins/{adminId} {
      allow read:                   if isOwner(adminId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── SOCIAL CONTENT ────────────────────────────────────────────────────────

    match /posts/{postId} {
      // Private, friends-only and close-friends posts are enforced here, not
      // only in the app (see canReadPostData).
      allow read: if canReadPostData(resource.data);
      // Require either text or a media URL so an empty document cannot be used
      // as a fake engagement anchor.
      allow create: if newOwnerMatches()
        && validContentIdentity(request.resource.data)
        && request.resource.data.get('text', '') is string
        && (request.resource.data.get('text', '') != ''
            || request.resource.data.get('mediaUrl', '') != ''
            || request.resource.data.get('mediaUrls', []).size() > 0
            // Poll/share posts may have no normal caption text
            || request.resource.data.get('type', '') == 'poll'
            || request.resource.data.get('sharedPostId', '') != '')
        // If the post claims a businessId:
        //  - visitors posting as themselves (authorType == 'user') are allowed on any business page
        //  - posting as the business identity (authorType == 'business') requires being the biz owner/admin
        && (request.resource.data.get('businessId', '') == ''
            || request.resource.data.get('authorType', 'user') == 'user'
            || canManageBiz(request.resource.data.get('businessId', '')));
      allow update: if isAdmin()
        || onlyCountersChanged()
        || onlyPollChanged()
        || (existingOwnerMatches() && onlyPostOwnerFields())
        // Business owner/page admin may manage any post on their page.
        || (canManageBiz(resource.data.get('businessId', ''))
            && resource.data.get('businessId', '') != ''
            && onlyPostManagementFields())
        // Group owner/admin/moderator may approve, decline, pin, or soft-delete group posts.
        || (isGroupManagerOfPost() && onlyPostManagementFields());
      allow delete: if isAdmin()
        || existingOwnerMatches()
        || (canManageBiz(resource.data.get('businessId', ''))
            && resource.data.get('businessId', '') != '')
        || isGroupManagerOfPost();

      match /comments/{commentId} {
        allow read: if canReadPostId(postId);
        allow create: if newOwnerMatches()
          && validContentIdentity(request.resource.data)
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() > 0;
        // Authors may edit text or soft-delete their own comments; counters are updated by reactions/replies.
        allow update: if contentIdentityUnchanged() && (isAdmin()
          || onlyCommentCountersChanged()
          || (existingOwnerMatches() && (onlyCommentTextChanged() || onlyCommentSoftDeleteChanged()))
          || isBizOwnerOfPost(postId));
        allow delete: if isAdmin() || existingOwnerMatches() || isBizOwnerOfPost(postId) || isPostOwner(postId);

        match /reactions/{rxUserId} {
          allow read: if canReadPostId(postId);
          allow create, update: if isOwner(rxUserId)
            && request.resource.data.get('userId', rxUserId) == uid();
          allow delete: if isAdmin() || isOwner(rxUserId);
        }

        match /replies/{replyId} {
          allow read: if canReadPostId(postId);
          allow create: if newOwnerMatches()
            && validContentIdentity(request.resource.data)
            && request.resource.data.get('text', '') is string
            && request.resource.data.get('text', '').size() > 0;
          allow update: if contentIdentityUnchanged() && (isAdmin() || existingOwnerMatches() || isBizOwnerOfPost(postId) || isPostOwner(postId));
          allow delete: if isAdmin() || existingOwnerMatches() || isBizOwnerOfPost(postId) || isPostOwner(postId);
        }
      }

      // Each like/reaction/poll/view doc ID is the user's own UID — self-only write.
      match /likes/{likeUserId}     { allow read: if canReadPostId(postId); allow create, update, delete: if isOwner(likeUserId); }
      match /reactions/{rxUserId}   { allow read: if canReadPostId(postId); allow create, update, delete: if isOwner(rxUserId); }
      match /pollVotes/{voteUserId} {
        allow read: if canReadPostId(postId);
        allow create: if isOwner(voteUserId)
          && request.resource.data.get('userId', voteUserId) == uid()
          && request.resource.data.get('optionId', '') is string;
        // Allow changing vote: only optionId and updatedAt may change
        allow update: if isOwner(voteUserId)
          && request.resource.data.get('optionId', '') is string
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['optionId', 'updatedAt']);
        allow delete: if isAdmin() || isOwner(voteUserId);
      }
      match /views/{viewerId} {
        allow read: if isAdmin() || isOwner(viewerId) || existingOwnerMatches();
        allow create, update: if isOwner(viewerId)
          && request.resource.data.get('userId', viewerId) == uid();
        allow delete: if isAdmin() || isOwner(viewerId);
      }
    }

    match /stories/{storyId} {
      // Close-friends stories are readable by the author and the people on
      // the list. Public stories carry closeFriends == false explicitly; a
      // story without the field counts as close-friends (restrictive default,
      // see canReadPostData).
      allow read: if resource.data.get('closeFriends', true) == false
        || (signedIn()
            && (resource.data.get('authorId', '') == uid()
                || resource.data.get('userId', '') == uid()
                || uid() in resource.data.get('closeFriendsList', [])
                || isAdmin()));
      allow create: if newOwnerMatches() && validContentIdentity(request.resource.data)
        && (request.resource.data.get('authorType', 'user') != 'business' || request.resource.data.get('closeFriends', true) == false);
      allow update: if contentIdentityUnchanged() && (
        isAdmin() || existingOwnerMatches() || onlyStoryViewFields()
        || (resource.data.get('authorType', '') == 'business' && canManageBiz(resource.data.get('businessId', ''))))
        && (request.resource.data.get('authorType', 'user') != 'business' || request.resource.data.get('closeFriends', true) == false);
      allow delete: if isAdmin() || existingOwnerMatches()
        || (resource.data.get('authorType', '') == 'business' && canManageBiz(resource.data.get('businessId', '')));

      match /reactions/{rxUserId} {
        allow read: if true;
        allow create, update: if isOwner(rxUserId);
        allow delete: if isAdmin() || isOwner(rxUserId);
      }

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if newOwnerMatches()
          && validContentIdentity(request.resource.data)
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() > 0;
        allow delete: if isAdmin() || existingOwnerMatches();
      }

      match /questionAnswers/{answerId} {
        allow read: if signedIn();
        allow create: if newOwnerMatches()
          && request.resource.data.get('answer', '') is string
          && request.resource.data.get('answer', '').size() > 0;
        allow delete: if isAdmin() || existingOwnerMatches();
      }
    }
    match /storyChains/{chainId} {
      allow read: if true;
      allow create: if newOwnerMatches();
      // Only the chain owner (or admin) may modify; previously any signed-in user could.
      allow update: if isAdmin() || existingOwnerMatches();
      allow delete: if isAdmin() || existingOwnerMatches();
    }
    match /checkins/{checkinId} { allow read: if true; allow create: if newOwnerMatches(); allow update, delete: if isAdmin() || existingOwnerMatches(); }
    function validCoordinatePair(data) {
      return (data.get('lat', null) == null && data.get('lng', null) == null)
        || (data.get('lat', null) is number && data.get('lng', null) is number
            && data.lat >= -90 && data.lat <= 90 && data.lng >= -180 && data.lng <= 180);
    }
    match /places/{placeId} {
      allow read: if true;
      allow create: if newOwnerMatches() && validCoordinatePair(request.resource.data);
      allow update: if (isAdmin() || existingOwnerMatches())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lat', 'lng'])
            || validCoordinatePair(request.resource.data));
      allow delete: if isAdmin() || existingOwnerMatches();
    }
    match /placeCategories/{catId} { allow read: if true; allow create, update, delete: if isAdmin(); }

    // Username reservation — each doc ID is the username (lowercase).
    // Any signed-in user may read (for availability check).
    // Only the owner may create (doc.uid must match caller).
    // Only the owner or admin may delete (to free up the username on change).
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.get('uid', '') == uid();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.get('uid', '') == uid());
    }

    // 5-digit numeric GeoHub IDs — claimed on signup, immutable after.
    match /geoIds/{geoId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.get('uid', '') == uid();
      allow update, delete: if isAdmin();
    }
    // Both of these are aggregate documents the client merges into. They were
    // fully writable by any signed-in user, so one setDoc could zero or inflate
    // any place's totals. Writes are now merge-shaped and monotonic.
    match /placeCheckins/{placeId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['count', 'lastCheckin'])
        && request.resource.data.get('count', 0) is number
        && request.resource.data.get('count', 0) >= 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastCheckin'])
        && request.resource.data.get('count', 0) is number
        // may only go up, and by at most one per write
        && request.resource.data.get('count', 0) >= resource.data.get('count', 0)
        && request.resource.data.get('count', 0) <= resource.data.get('count', 0) + 1;
      allow delete: if isAdmin();
    }
    match /placeMoodTags/{placeId} {
      allow read: if true;
      allow create: if signedIn();
      // A merge may add or change tags but never drop the document's contents.
      allow update: if signedIn()
        && request.resource.data.keys().size() >= resource.data.keys().size();
      allow delete: if isAdmin();
    }

    // ── BUSINESSES ────────────────────────────────────────────────────────────

    function validMenuPhoto(photo) {
      // The displayed URL is validated here. Optional media/source metadata is
      // normalized by the editor, keeping twenty photos below the rule budget.
      return photo.url is string && photo.url.size() <= 2048 && photo.url.matches('^https://[^ ]+$');
    }
    function menuPhotoAt(data, index) {
      return data.menuPhotos.size() <= index || validMenuPhoto(data.menuPhotos[index]);
    }
    function validMenuPhotos(data) {
      return !data.keys().hasAny(['menuPhotos'])
        || (data.menuPhotos is list && data.menuPhotos.size() <= 20
            && menuPhotoAt(data, 0) && menuPhotoAt(data, 1) && menuPhotoAt(data, 2) && menuPhotoAt(data, 3)
            && menuPhotoAt(data, 4) && menuPhotoAt(data, 5) && menuPhotoAt(data, 6) && menuPhotoAt(data, 7)
            && menuPhotoAt(data, 8) && menuPhotoAt(data, 9) && menuPhotoAt(data, 10) && menuPhotoAt(data, 11)
            && menuPhotoAt(data, 12) && menuPhotoAt(data, 13) && menuPhotoAt(data, 14) && menuPhotoAt(data, 15)
            && menuPhotoAt(data, 16) && menuPhotoAt(data, 17) && menuPhotoAt(data, 18) && menuPhotoAt(data, 19));
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create: if newOwnerMatches() && validMenuPhotos(request.resource.data);
      allow update: if (canManageBiz(businessId) || existingOwnerMatches() || onlyBusinessCountersChanged())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['menuPhotos']) || validMenuPhotos(request.resource.data));
      allow delete: if canManageBiz(businessId) || existingOwnerMatches();

      match /storyArchive/{storyId} {
        allow read, delete: if canManageBiz(businessId);
        allow create: if canManageBiz(businessId)
          && validContentIdentity(request.resource.data)
          && request.resource.data.get('authorType', '') == 'business'
          && request.resource.data.get('businessId', '') == businessId;
      }

      // ── Services, products, and price list: owner/page-admin CRUD, public read ──
      match /services/{serviceId} {
        allow read: if true;
        allow create, update, delete: if canManageBiz(businessId);
      }
      match /products/{productId} {
        allow read: if true;
        allow create, update, delete: if canManageBiz(businessId);
      }
      match /priceList/{itemId} {
        allow read: if true;
        allow create, update, delete: if canManageBiz(businessId);
      }

      // ── Gallery: owner can CRUD, public read ──────────────────────────
      match /gallery/{photoId} {
        allow read: if true;
        allow create, update, delete: if canManageBiz(businessId);
      }

      // ── Quote requests: any signed-in user can submit (self-attributed).
      // Only the business owner and admins can read them.
      match /quoteRequests/{reqId} {
        allow create: if signedIn()
          && request.resource.data.get('submittedBy', '') == uid()
          && request.resource.data.get('businessId', '') == businessId
          && request.resource.data.get('name',    '') is string
          && request.resource.data.get('message', '') is string;
        allow read: if canManageBiz(businessId)
          || (signedIn() && resource.data.get('submittedBy', '') == uid());
        allow update: if canManageBiz(businessId)
          || (signedIn() && resource.data.get('submittedBy', '') == uid()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
        allow delete: if isAdmin();
      }

      // ── QR scan logs: unchanged ──────────────────────────────────────
      match /qrScanLogs/{logId} {
        allow create: if signedIn() && request.resource.data.get('userId', '') == uid();
        allow read: if canManageBiz(businessId);
        allow update, delete: if isAdmin();
      }
      match /subscriptions/{subId} {
        allow read: if canManageBiz(businessId) || (signedIn() && resource.data.get('ownerId', '') == uid());
        allow create, update, delete: if isAdmin();
      }

      // ── Page Blocks: public can read enabled blocks; only owner/admin can write ──
      match /pageBlocks/{blockId} {
        allow read: if resource.data.get('enabled', true) == true || canManageBiz(businessId);
        allow create, update, delete: if canManageBiz(businessId);
      }

      // Per-page admin roles used by Business Page Pro Tools.
      match /admins/{adminUserId} {
        allow read: if canManageBiz(businessId) || isOwner(adminUserId);
        allow create, update, delete: if isAdmin() || isBizOwner(businessId) || isBizDocOwner(businessId);
      }

      match /events/{eventId} {
        allow read: if true;
        allow create, update, delete: if canManageBiz(businessId);

        match /rsvps/{rsvpUserId} {
          allow read: if true;
          allow create, update: if isOwner(rsvpUserId)
            && request.resource.data.get('userId', rsvpUserId) == uid();
          allow delete: if isAdmin() || isOwner(rsvpUserId) || canManageBiz(businessId);
        }
      }

      match /faq/{faqId} {
        allow read: if true;
        allow create, update, delete: if canManageBiz(businessId);
      }

      match /faqQuestions/{questionId} {
        allow read: if canManageBiz(businessId)
          || (signedIn() && resource.data.get('userId', '') == uid());
        allow create: if signedIn()
          && request.resource.data.get('userId', '') == uid();
        allow update: if canManageBiz(businessId)
          || (signedIn() && resource.data.get('userId', '') == uid()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question', 'updatedAt']));
        allow delete: if canManageBiz(businessId)
          || (signedIn() && resource.data.get('userId', '') == uid());
      }

      match /milestones/{milestoneId} {
        allow read: if true;
        allow create, update, delete: if canManageBiz(businessId);
      }

      match /analytics/{dateDoc} {
        allow read: if canManageBiz(businessId);
        // View/click counters are written by visitors, so this stays open to
        // signed-in users — but only for the counter fields.
        allow create: if signedIn();
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['views', 'clicks', 'calls', 'directions', 'saves', 'shares', 'updatedAt']);
        allow delete: if isAdmin();
      }

      match /invites/{inviteId} {
        allow read: if canManageBiz(businessId)
          || (signedIn()
              && (resource.data.get('invitedEmail', '') == request.auth.token.email
                  || resource.data.get('inviteeEmail', '') == request.auth.token.email));
        allow create: if canManageBiz(businessId)
          && request.resource.data.get('businessId', '') == businessId;
        allow update: if canManageBiz(businessId)
          || (signedIn()
              && (resource.data.get('invitedEmail', '') == request.auth.token.email
                  || resource.data.get('inviteeEmail', '') == request.auth.token.email)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']));
        allow delete: if canManageBiz(businessId);
      }

      match /staff/{staffUserId} {
        allow read: if true;
        allow create, update: if canManageBiz(businessId)
          || (isOwner(staffUserId)
              && request.resource.data.get('userId', staffUserId) == uid());
        allow delete: if canManageBiz(businessId) || isOwner(staffUserId);
      }
    }
    match /businessAdmins/{adminId} {
      allow read: if true;
      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.get('userId', '') == uid()
            && request.resource.data.get('businessId', '') is string
            && request.resource.data.get('businessId', '') != ''
            && adminId == request.resource.data.businessId + '_' + uid()
            && get(/databases/$(database)/documents/businesses/$(request.resource.data.get('businessId',''))).data.get('ownerId','') == uid());
      allow update: if isAdmin();
      allow delete: if isAdmin() || resource.data.get('userId', '') == uid()
        || (signedIn() && get(/databases/$(database)/documents/businesses/$(resource.data.get('businessId',''))).data.get('ownerId','') == uid());
    }
    match /businessFollowers/{followId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.get('userId', '') == uid();
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.get('userId', '') == uid());
    }
    match /businessReviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.get('userId', '') == uid();
      allow update: if isAdmin()
        || (signedIn() && resource.data.get('userId', '') == uid())
        || onlyBusinessReviewCountersChanged()
        || (canManageBiz(resource.data.get('businessId', '')) && onlyBusinessOwnerReplyChanged());
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('userId', '') == uid())
        || canManageBiz(resource.data.get('businessId', ''));
    }
    match /businessOffers/{offerId} {
      allow read: if true;
      allow create: if signedIn() && newOwnerMatches()
        && canManageBiz(request.resource.data.get('businessId', ''));
      allow update: if canManageBiz(resource.data.get('businessId', ''))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['businessId', 'createdBy', 'ownerId', 'createdAt']);
      allow delete: if canManageBiz(resource.data.get('businessId', ''));
    }
    match /businessAnalytics/{analyticsId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('ownerId', '') == uid());
      allow create, update: if signedIn() && request.resource.data.get('ownerId', '') == uid();
      allow delete: if isAdmin();
    }

    // ── STRUCTURED COMMERCE ───────────────────────────────────────────────────
    // New collections preserve legacy services/products/offers. Drafts are
    // private; public queries must explicitly constrain status == published.
    function commerceText(value, maximum) {
      return value is string && value.size() <= maximum;
    }
    function commerceId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,150}$');
    }
    function commerceMoney(value) {
      return value is int && value >= 0 && value <= 100000000;
    }
    function commerceUrl(value) {
      return commerceText(value, 2048) && (value == '' || value.matches('^https://[^ ]+$'));
    }
    function commerceMeta(data) {
      return commerceId(data.businessId)
        && data.status in ['draft', 'published', 'archived']
        && commerceText(data.title, 160) && data.title.size() > 0
        && data.isDemo is bool && data.datasetVersion == 1
        && ((data.isDemo == false && data.demoBatchId == '')
            || (data.isDemo == true && commerceId(data.demoBatchId)))
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function commerceImmutable() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'businessId', 'createdBy', 'createdAt', 'isDemo', 'demoBatchId', 'datasetVersion'
      ]);
    }
    function commerceCreate(data) {
      return signedIn() && data.createdBy == uid() && data.createdAt == request.time
        && canManageBiz(data.businessId)
        && exists(/databases/$(database)/documents/businesses/$(data.businessId))
        && (data.isDemo == false || isAdmin());
    }
    function commerceArchiveOnly() {
      return request.resource.data.status == 'archived'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
    }
    function commerceBranchAt(data, index) {
      return data.branchIds.size() <= index
        || (commerceId(data.branchIds[index])
            && commerceBranchMatches(get(/databases/$(database)/documents/businessBranches/$(data.branchIds[index])).data, data));
    }
    function commerceBranchMatches(branch, data) {
      return branch.businessId == data.businessId && branch.status == 'published'
        && branch.isDemo == data.isDemo && branch.demoBatchId == data.demoBatchId;
    }
    function commerceBranches(data) {
      return data.allBranches is bool && data.branchIds is list && data.branchIds.size() <= 5
        && data.branchIds.toSet().size() == data.branchIds.size()
        && ((data.allBranches == true && data.branchIds.size() == 0)
            || (data.allBranches == false && data.branchIds.size() > 0
                && commerceBranchAt(data, 0) && commerceBranchAt(data, 1) && commerceBranchAt(data, 2)
                && commerceBranchAt(data, 3) && commerceBranchAt(data, 4)));
    }
    function commerceComponentAt(data, itemId, index) {
      return data.bundleItemIds.size() <= index
        || (commerceId(data.bundleItemIds[index]) && data.bundleItemIds[index] != itemId
            && commerceComponentMatches(get(/databases/$(database)/documents/commerceItems/$(data.bundleItemIds[index])).data, data));
    }
    function commerceComponentMatches(item, data) {
      return item.businessId == data.businessId && item.type != 'bundle'
        && item.isDemo == data.isDemo && item.demoBatchId == data.demoBatchId;
    }
    function commerceItem(data, itemId) {
      return data.keys().hasOnly([
          'businessId', 'type', 'title', 'description', 'categoryId', 'imageUrl', 'imageAssetId', 'sourceUrl',
          'priceMinor', 'currency', 'status', 'available', 'allBranches', 'branchIds', 'dietaryTags',
          'preparationMinutes', 'bundleItemIds', 'isDemo', 'demoBatchId', 'datasetVersion', 'createdBy', 'createdAt', 'updatedAt'
        ]) && commerceMeta(data) && commerceBranches(data)
        && data.type in ['product', 'dish', 'service', 'bundle']
        && commerceText(data.description, 4000) && commerceText(data.categoryId, 100)
        && commerceUrl(data.imageUrl) && commerceUrl(data.sourceUrl) && commerceText(data.imageAssetId, 300)
        && (data.priceMinor == null || commerceMoney(data.priceMinor))
        && data.currency in ['GEL', 'USD', 'EUR'] && data.available is bool
        && data.dietaryTags is list && data.dietaryTags.size() <= 5
        && data.dietaryTags.toSet().size() == data.dietaryTags.size()
        && data.dietaryTags.hasOnly(['vegetarian', 'vegan', 'halal', 'gluten-free', 'dairy-free'])
        && (data.preparationMinutes == null || (data.preparationMinutes is int && data.preparationMinutes >= 1 && data.preparationMinutes <= 1440))
        && (data.type == 'dish' || (data.dietaryTags.size() == 0 && data.preparationMinutes == null))
        && data.bundleItemIds is list && data.bundleItemIds.size() <= 5
        && data.bundleItemIds.size() + data.branchIds.size() <= 5
        && data.bundleItemIds.toSet().size() == data.bundleItemIds.size()
        && ((data.type != 'bundle' && data.bundleItemIds.size() == 0)
            || (data.type == 'bundle' && data.bundleItemIds.size() > 0
                && commerceComponentAt(data, itemId, 0) && commerceComponentAt(data, itemId, 1) && commerceComponentAt(data, itemId, 2)
                && commerceComponentAt(data, itemId, 3) && commerceComponentAt(data, itemId, 4)));
    }
    function commerceOffer(data) {
      return data.keys().hasOnly([
          'businessId', 'itemId', 'type', 'categoryId', 'title', 'description', 'conditions', 'imageUrl',
          'originalPriceMinor', 'priceMinor', 'currency', 'startsAtMs', 'endsAtMs', 'status',
          'allBranches', 'branchIds', 'isDemo', 'demoBatchId', 'datasetVersion', 'createdBy', 'createdAt', 'updatedAt'
        ]) && commerceMeta(data) && commerceBranches(data)
        && commerceId(data.itemId) && data.type in ['product', 'dish', 'service', 'bundle']
        && commerceText(data.description, 4000) && commerceText(data.conditions, 2000)
        && commerceText(data.categoryId, 100) && commerceUrl(data.imageUrl)
        && commerceMoney(data.originalPriceMinor) && commerceMoney(data.priceMinor)
        && data.originalPriceMinor > data.priceMinor && data.currency in ['GEL', 'USD', 'EUR']
        && data.startsAtMs is int && data.startsAtMs >= 0
        && data.endsAtMs is int && data.endsAtMs > data.startsAtMs && data.endsAtMs <= 4102444800000;
    }
    function commerceOfferItem(data) {
      let item = get(/databases/$(database)/documents/commerceItems/$(data.itemId)).data;
      return item.businessId == data.businessId && item.status == 'published' && item.available == true
        && item.type == data.type && item.currency == data.currency && item.categoryId == data.categoryId
        && item.priceMinor == data.originalPriceMinor
        && item.isDemo == data.isDemo && item.demoBatchId == data.demoBatchId
        && (item.allBranches == true || (data.allBranches == false && item.branchIds.hasAll(data.branchIds)));
    }
    match /commerceItems/{itemId} {
      allow read: if resource.data.status == 'published' || canManageBiz(resource.data.businessId);
      allow create: if commerceItem(request.resource.data, itemId) && commerceCreate(request.resource.data);
      allow update: if canManageBiz(resource.data.businessId) && commerceImmutable()
        && (commerceArchiveOnly() || commerceItem(request.resource.data, itemId));
      // A live item is archived so linked offers/history keep their identity.
      allow delete: if isAdmin() && resource.data.isDemo == true;
    }
    match /commerceOffers/{offerId} {
      allow read: if resource.data.status == 'published' || canManageBiz(resource.data.businessId);
      allow create: if commerceOffer(request.resource.data) && commerceOfferItem(request.resource.data) && commerceCreate(request.resource.data);
      allow update: if canManageBiz(resource.data.businessId) && commerceImmutable()
        && request.resource.data.itemId == resource.data.itemId
        && (commerceArchiveOnly() || (commerceOffer(request.resource.data) && commerceOfferItem(request.resource.data)));
      allow delete: if isAdmin() && resource.data.isDemo == true;
    }
    match /businessBranches/{branchId} {
      function validBranch(data) {
        return data.keys().hasOnly([
            'businessId', 'placeId', 'parentMallId', 'title', 'address', 'city', 'lat', 'lng', 'status',
            'isDemo', 'demoBatchId', 'datasetVersion', 'createdBy', 'createdAt', 'updatedAt'
          ]) && commerceMeta(data) && validCoordinatePair(data)
          && (data.placeId == '' || (commerceId(data.placeId) && exists(/databases/$(database)/documents/places/$(data.placeId))))
          && (data.get('parentMallId', '') == '' || (commerceId(data.parentMallId) && exists(/databases/$(database)/documents/places/$(data.parentMallId))))
          && commerceText(data.address, 300) && commerceText(data.city, 100);
      }
      allow read: if resource.data.status == 'published' || canManageBiz(resource.data.businessId);
      allow create: if validBranch(request.resource.data) && commerceCreate(request.resource.data);
      allow update: if canManageBiz(resource.data.businessId) && commerceImmutable()
        && (commerceArchiveOnly() || validBranch(request.resource.data));
      allow delete: if isAdmin() && resource.data.isDemo == true;
    }
    // Cleanup manifests are administrator-only and must never contain business
    // or place deletes. The deletion tool revalidates each targeted document.
    match /commerceDemoBatches/{batchId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ── SOCIAL GRAPH ──────────────────────────────────────────────────────────

    match /businessAdCampaigns/{campaignId} {
      allow read: if signedIn() && canManageBiz(resource.data.get('businessId', ''));
      allow create: if signedIn()
        && request.resource.data.get('businessId', '') is string
        && canManageBiz(request.resource.data.get('businessId', ''))
        && request.resource.data.get('ownerUid', '') == uid()
        && request.resource.data.get('status', '') in ['draft', 'pending_review', 'paused', 'rejected', 'active_mock']
        && request.resource.data.keys().hasOnly([
          'businessId', 'ownerUid', 'postId', 'objective', 'city', 'interest',
          'budgetGel', 'durationDays', 'status', 'createdAt', 'updatedAt'
        ]);
      allow update: if signedIn()
        && canManageBiz(resource.data.get('businessId', ''))
        && request.resource.data.get('businessId', '') == resource.data.get('businessId', '')
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && request.resource.data.get('status', '') in ['draft', 'pending_review', 'paused', 'rejected', 'active_mock']
        && request.resource.data.keys().hasOnly([
          'businessId', 'ownerUid', 'postId', 'objective', 'city', 'interest',
          'budgetGel', 'durationDays', 'status', 'createdAt', 'updatedAt'
        ]);
      allow delete: if signedIn() && canManageBiz(resource.data.get('businessId', ''));
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['followerId', 'followingId', 'createdAt'])
        && request.resource.data.get('followerId', '') == uid()
        // Users may not follow themselves
        && request.resource.data.get('followingId', '') != uid();
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn()
            && (resource.data.get('followerId', '') == uid()
                || resource.data.get('followingId', '') == uid()));
    }
    match /savedPosts/{saveId} {
      allow read: if signedIn()
        && (resource.data.get('userId', '') == uid()
            || resource.data.get('uid', '') == uid()
            || isAdmin());
      allow create: if signedIn()
        && (request.resource.data.get('userId', '') == uid()
            || request.resource.data.get('uid', '') == uid());
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn()
            && (resource.data.get('userId', '') == uid()
                || resource.data.get('uid', '') == uid()));
    }
    match /savedItems/{itemId} {
      allow read: if signedIn()
        && (resource.data.get('userId', '') == uid()
            || resource.data.get('uid', '') == uid()
            || isAdmin());
      allow create: if signedIn()
        && (request.resource.data.get('userId', '') == uid()
            || request.resource.data.get('uid', '') == uid());
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn()
            && (resource.data.get('userId', '') == uid()
                || resource.data.get('uid', '') == uid()));
    }

    // ── GROUPS ────────────────────────────────────────────────────────────────

    match /groups/{groupId} {
      allow read: if true;
      allow create: if newOwnerMatches();
      allow update: if isAdmin() || existingOwnerMatches() || isGroupOwnerOrAdmin(groupId) || onlyGroupCountersChanged();
      allow delete: if isAdmin() || existingOwnerMatches() || isGroupOwnerOrAdmin(groupId);

      match /bans/{bannedUserId} {
        allow read: if isAdmin() || isGroupManager(groupId) || isOwner(bannedUserId);
        allow create, update, delete: if isAdmin() || isGroupManager(groupId);
      }

      match /events/{eventId} {
        allow read: if isGroupPublic(groupId) || isGroupMember(groupId) || isAdmin();
        allow create, update, delete: if isAdmin() || isGroupManager(groupId);

        match /rsvps/{rsvpUserId} {
          allow read: if isGroupPublic(groupId) || isGroupMember(groupId) || isAdmin();
          allow create, update: if isOwner(rsvpUserId)
            && request.resource.data.get('userId', rsvpUserId) == uid();
          allow delete: if isAdmin() || isOwner(rsvpUserId) || isGroupManager(groupId);
        }
      }

      match /files/{fileId} {
        allow read: if isGroupPublic(groupId) || isGroupMember(groupId) || isAdmin();
        allow create: if signedIn()
          && request.resource.data.get('uploaderId', '') == uid();
        allow update, delete: if isAdmin()
          || isGroupManager(groupId)
          || (signedIn() && resource.data.get('uploaderId', '') == uid());
      }

      match /chatMessages/{messageId} {
        allow read: if isGroupPublic(groupId) || isGroupMember(groupId) || isAdmin();
        allow create: if signedIn()
          && request.resource.data.get('senderId', '') == uid();
        allow update, delete: if isAdmin()
          || isGroupManager(groupId)
          || (signedIn() && resource.data.get('senderId', '') == uid());
      }
    }
    // groupMembers/{groupId}_{uid}. Joining is self-service only as a plain
    // member: open groups directly, private/secret groups only after a
    // manager approved the join request. Only the group's creator may give
    // themselves a managing role; roles of others are changed by the group's
    // owner/admins, never by the member, and the creator cannot be demoted.
    match /groupMembers/{memberId} {
      allow read: if true;
      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.get('uid', '') == uid()
            && request.resource.data.get('userId', uid()) == uid()
            && memberId == request.resource.data.get('groupId', '') + '_' + uid()
            && ((request.resource.data.get('role', 'member') == 'member'
                 && (isGroupPublic(request.resource.data.get('groupId', ''))
                     || joinRequestApproved(request.resource.data.get('groupId', ''), uid())))
                || (request.resource.data.get('role', '') in ['admin', 'owner']
                    && isGroupCreator(request.resource.data.get('groupId', '')))));
      allow update: if isAdmin()
        || (signedIn() && memberIdsUnchanged()
            && ((isOwnMembership()
                 && !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['role', 'status', 'groupId', 'uid', 'userId']))
                || (isGroupOwnerOrAdmin(resource.data.get('groupId', ''))
                    && !isOwnMembership()
                    && !memberIsGroupCreator()
                    && request.resource.data.get('role', 'member') in ['member', 'moderator', 'admin'])));
      allow delete: if isAdmin()
        || (signedIn() && isOwnMembership())
        || (isGroupManager(resource.data.get('groupId', '')) && !memberIsGroupCreator());

      function isOwnMembership() {
        return resource.data.get('uid', '') == uid() || resource.data.get('userId', '') == uid();
      }
      function memberIdsUnchanged() {
        return request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
          && request.resource.data.get('uid', '') == resource.data.get('uid', '')
          && request.resource.data.get('userId', '') == resource.data.get('userId', '');
      }
      function memberIsGroupCreator() {
        let g = get(/databases/$(database)/documents/groups/$(resource.data.get('groupId', ''))).data;
        let member = resource.data.get('uid', resource.data.get('userId', ''));
        return g.get('creatorId', g.get('userId', '')) == member;
      }
    }
    function isGroupCreator(groupId) {
      let g = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return signedIn()
        && (g.get('creatorId', '') == uid() || g.get('userId', '') == uid() || g.get('ownerId', '') == uid());
    }
    // groupJoinRequests/{groupId}__{uid}
    function joinRequestApproved(groupId, userId) {
      return exists(/databases/$(database)/documents/groupJoinRequests/$(groupId + '__' + userId))
        && get(/databases/$(database)/documents/groupJoinRequests/$(groupId + '__' + userId)).data.get('status', '') == 'approved';
    }
    match /groupPosts/{postId} {
      // Public-group posts are readable by everyone; private/secret group posts
      // are restricted to members.  groupPrivacy is denormalised onto each post
      // at creation time to avoid a get() per rule evaluation.
      allow read: if resource.data.get('groupPrivacy', '') == 'public'
        || isGroupMember(resource.data.get('groupId', ''))
        || isAdmin();
      allow create: if newOwnerMatches();
      allow update, delete: if isAdmin() || existingOwnerMatches() || onlyCountersChanged();
    }
    match /groupJoinRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.get('userId', '') == uid()
            || resource.data.get('toUserId', '') == uid()
            || isGroupManager(resource.data.get('groupId', ''))
            || isAdmin());
      allow create: if signedIn()
        && request.resource.data.get('userId', '') == uid()
        && request.resource.data.get('status', '') == 'pending'
        && requestId == request.resource.data.get('groupId', '') + '__' + uid();
      allow update: if isAdmin()
        || ((isGroupManager(resource.data.get('groupId', ''))
             // the requester may re-send a declined request, nothing more
             || (signedIn() && resource.data.get('userId', '') == uid()
                 && request.resource.data.get('status', '') == 'pending'))
            && request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
            && request.resource.data.get('userId', '') == resource.data.get('userId', ''));
      allow delete: if isAdmin()
        || isGroupManager(resource.data.get('groupId', ''))
        || (signedIn() && resource.data.get('userId', '') == uid());
    }

    // ── EVENTS ────────────────────────────────────────────────────────────────

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /eventParticipants/{participantId} {
      allow read: if true;
      allow create: if signedIn()
        && (request.resource.data.get('userId', '') == uid()
            || request.resource.data.get('uid', '') == uid());
      allow update, delete: if isAdmin()
        || (signedIn()
            && (resource.data.get('userId', '') == uid()
                || resource.data.get('uid', '') == uid()));
    }

    // ── MESSAGING ─────────────────────────────────────────────────────────────

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource == null
            || resource.data.get('fromUserId', '') == uid()
            || resource.data.get('toUserId', '') == uid()
            || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['fromUserId', 'toUserId', 'status', 'createdAt'])
        && request.resource.data.get('fromUserId', '') == uid()
        // Cannot send a request to yourself
        && request.resource.data.get('toUserId', '') != uid()
        && request.resource.data.get('status', '') == 'pending'
        && requestId == uid() + '_' + request.resource.data.get('toUserId', '');
      // Only the recipient answers a pending request. The sender may re-send
      // (status back to 'pending') but can never mark it accepted — an
      // accepted request is what lets a friendship document be created.
      allow update: if isAdmin()
        || (signedIn()
            && request.resource.data.get('fromUserId', '') == resource.data.get('fromUserId', '')
            && request.resource.data.get('toUserId', '') == resource.data.get('toUserId', '')
            && ((resource.data.get('toUserId', '') == uid()
                 && resource.data.get('status', '') == 'pending'
                 && request.resource.data.get('status', '') in ['accepted', 'rejected', 'declined']
                 && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'reviewedAt', 'respondedAt', 'updatedAt']))
                || (resource.data.get('fromUserId', '') == uid()
                    && request.resource.data.get('status', '') == 'pending')));
      allow delete: if isAdmin()
        || (signedIn()
            && (resource.data.get('fromUserId', '') == uid()
                || resource.data.get('toUserId', '') == uid()));
    }
    match /friends/{friendId} {
      allow read: if true;
      // Being in the users array was the only requirement, so anyone could
      // declare themselves a friend of anyone. The relationship now has to come
      // from a friendRequests document both sides agreed on.
      allow create: if signedIn()
        && uid() in request.resource.data.users
        && request.resource.data.users.size() == 2
        && friendRequestAccepted(request.resource.data.users[0],
                                 request.resource.data.users[1]);
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && uid() in resource.data.users);
    }

    // ── LIVE LOCATION (GPS sharing between friends) ───────────────────────────
    // Users write only their own doc.
    // Read: owner always; others only when sharing='friends' (opt-in GPS share).
    // Previously any signed-in user could read any user's location.
    match /userLocations/{userId} {
      // 'friends' is the owner's opt-in, not a public flag: the reader has to
      // be a friend as well. Without the second half of this condition every
      // signed-in user could read the live GPS of anyone who opted in.
      allow read: if isOwner(userId)
        || isAdmin()
        || (signedIn()
            && resource.data.get('sharing', 'off') == 'friends'
            && areFriends(uid(), userId));
      allow create, update: if isOwner(userId)
        && request.resource.data.get('uid', '') == userId;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── FRIENDSHIPS (new canonical collection) ────────────────────────────────
    // friendshipId = sorted([uid1, uid2]).join('_')
    match /friendships/{friendshipId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['users', 'user1', 'user2', 'createdAt'])
        && uid() in request.resource.data.users
        // Cannot friend yourself
        && request.resource.data.user1 != request.resource.data.user2
        // The document ID is the canonical sorted pair, and the pair must have
        // an accepted request behind it — otherwise this is a unilateral claim.
        && friendshipId == friendPairId(request.resource.data.user1, request.resource.data.user2)
        && friendRequestAccepted(request.resource.data.user1, request.resource.data.user2);
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && uid() in resource.data.users);
    }

    match /conversations/{conversationId} {
      // Phase 57: also accept memberUids (canonical) alongside legacy participants.
      allow create: if signedIn() && (
        uid() in request.resource.data.get('participants', [])
        || uid() in request.resource.data.get('memberUids', [])
        || (request.resource.data.get('forBusiness', false) == true
            && (request.resource.data.get('ownerUid', '') == uid()
                || request.resource.data.get('customerUid', '') == uid()))
      ) && (request.resource.data.get('forBusiness', false) != true || validNewBusinessConversation(request.resource.data));
      allow read, delete: if isAdmin()
        || (signedIn() && uid() in resource.data.get('participants', []))
        || (signedIn() && uid() in resource.data.get('memberUids', []))
        || (signedIn()
            && resource.data.get('forBusiness', false) == true
            && (resource.data.get('ownerUid', '') == uid()
                || resource.data.get('customerUid', '') == uid()));
      allow update: if conversationIdentityUnchanged() && (isAdmin() || isConversationParticipant(conversationId));

      match /messages/{messageId} {
        allow read: if isAdmin() || isConversationParticipant(conversationId);
        // Only a participant may create a message and only as themselves.
        allow create: if signedIn() && (isAdmin() || isConversationParticipant(conversationId))
          && validMessageIdentity(conversationId, request.resource.data);
        // Sender may edit their own message; any participant may mark it
        // deleted/liked (narrow field allowlist).
        allow update: if isAdmin()
          || (signedIn() && resource.data.senderId == uid() && onlyMessageSenderEditChanged())
          || (isConversationParticipant(conversationId) && onlyMessageParticipantMetaChanged());
        allow delete: if isAdmin()
          || (signedIn() && resource.data.senderId == uid());
      }
    }

    // Message reactions: broad read (needed before the reaction doc exists)
    // but tightly validated on write.
    match /messageReactions/{reactionId} {
      // Was readable by every signed-in user, which exposed who reacted to what
      // inside private conversations.
      allow read: if isAdmin()
        || (signedIn()
            && (resource == null
                || isConversationParticipant(resource.data.get('conversationId', ''))));
      allow create: if signedIn()
        && request.resource.data.get('userId', '') == uid()
        && request.resource.data.get('conversationId', '') is string
        && request.resource.data.get('messageId',      '') is string
        && request.resource.data.get('emoji',          '') is string
        && request.resource.data.keys().hasOnly([
             'conversationId', 'messageId', 'userId', 'emoji', 'createdAt', 'updatedAt'
           ])
        && isConversationParticipant(request.resource.data.conversationId);
      allow update: if signedIn()
        && resource.data.get('userId', '') == uid()
        && request.resource.data.get('userId', '') == uid()
        // Immutable fields must not change
        && request.resource.data.get('conversationId', '') == resource.data.get('conversationId', '')
        && request.resource.data.get('messageId',      '') == resource.data.get('messageId',      '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji', 'updatedAt']);
      allow delete: if signedIn() && resource.data.get('userId', '') == uid();
    }

    match /userConversationSettings/{settingId} {
      allow read: if signedIn()
        && (resource.data.get('userId', '') == uid() || isAdmin());
      allow create, update: if onlyConversationSettingsOwner();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('userId', '') == uid());
    }

    match /chats/{chatId} {
      allow create: if signedIn()
        && (uid() in request.resource.data.get('participants', [])
            || uid() in request.resource.data.get('members', []));
      allow read, update, delete: if isAdmin()
        || (signedIn()
            && (uid() in resource.data.get('participants', [])
                || uid() in resource.data.get('members', [])));
      match /messages/{messageId} {
        allow read: if isAdmin()
          || (signedIn()
              && (uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])
                  || uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.get('members', [])));
        allow create: if isAdmin()
          || (signedIn()
              && (uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])
                  || uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.get('members', []))
              && (request.resource.data.get('senderId', '') == uid()
                  || request.resource.data.get('userId', '') == uid()
                  || request.resource.data.get('authorId', '') == uid()));
        allow update: if isAdmin()
          || (signedIn() && resource.data.get('senderId', '') == uid() && onlyMessageSenderEditChanged())
          || (signedIn()
              && (uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])
                  || uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.get('members', []))
              && onlyMessageParticipantMetaChanged());
        allow delete: if isAdmin()
          || (signedIn() && resource.data.get('senderId', '') == uid());
      }
    }

    // Legacy top-level messages collection (kept for back-compat with older
    // message threads; prefer /conversations for new writes).
    match /messages/{messageId} {
      allow read: if isAdmin()
        || (signedIn()
            && (resource.data.get('senderId',    '') == uid()
                || resource.data.get('userId',    '') == uid()
                || resource.data.get('recipientId','') == uid()));
      allow create: if signedIn()
        && (request.resource.data.get('senderId',    '') == uid()
            || request.resource.data.get('userId',   '') == uid()
            || request.resource.data.get('createdBy','') == uid());
      allow update, delete: if isAdmin()
        || (signedIn()
            && (resource.data.get('senderId', '') == uid()
                || resource.data.get('userId', '') == uid()));
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────────────────────

    function validNotificationSender(data) {
      return !data.keys().hasAny(['fromActorType', 'fromActorId'])
        || (data.get('fromActorType', '') == 'user' && data.get('fromActorId', '') == uid())
        || (data.get('fromActorType', '') == 'business'
          && data.get('fromActorId', '') is string && data.fromActorId != ''
          && canManageBiz(data.fromActorId));
    }
    match /userNotifications/{notificationId} {
      allow read: if signedIn()
        && (resource.data.get('userId',   '') == uid()
            || resource.data.get('toUserId','') == uid()
            || (resource.data.get('targetActorType', '') == 'user'
                && resource.data.get('targetActorId', '') == uid())
            || (resource.data.get('targetActorType', '') == 'business'
                && canManageBiz(resource.data.get('targetActorId', resource.data.get('businessId', ''))))
            || isAdmin());
      allow create: if isAdmin()
        || (signedIn()
            // fromUserId must match the caller (prevents spoofing).
            // Self-notifications (badge, reward) are allowed: userId == toUserId == uid().
            && request.resource.data.get('fromUserId', '') == uid()
            && validNotificationSender(request.resource.data));
      // Recipients may only mark a notification read/seen, nothing else.
      allow update: if isAdmin()
        || (signedIn()
            && (resource.data.get('userId',   '') == uid()
                || resource.data.get('toUserId','') == uid()
                || (resource.data.get('targetActorType', '') == 'user'
                    && resource.data.get('targetActorId', '') == uid())
                || (resource.data.get('targetActorType', '') == 'business'
                    && canManageBiz(resource.data.get('targetActorId', resource.data.get('businessId', '')))))
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['read', 'seen', 'openedAt', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ── REVIEWS ───────────────────────────────────────────────────────────────

    function validPlaceReview(data) {
      let tags = data.get('experienceTags', []);
      return data.get('placeId', '') is string
        && data.placeId.matches('^[A-Za-z0-9_-]{1,150}$')
        && data.get('rating', 0) is int && data.rating >= 1 && data.rating <= 5
        && data.get('comment', '') is string && data.get('comment', '').size() <= 1000
        && tags is list && tags.size() <= 6 && tags.toSet().size() == tags.size()
        && tags.hasOnly(['tasty', 'good-service', 'cozy', 'quiet', 'lively', 'good-value',
          'family-friendly', 'fast-service', 'clean', 'easy-parking', 'accessible', 'good-for-work']);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if newOwnerMatches();
      allow update, delete: if isAdmin() || existingOwnerMatches();
    }
    match /placeReviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.get('userId', '') == uid()
        && validPlaceReview(request.resource.data);
      allow update: if (isAdmin() || (signedIn() && resource.data.get('userId', '') == uid()))
        && validPlaceReview(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'placeId', 'createdAt']);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('userId', '') == uid());
    }

    // ── ECONOMY ───────────────────────────────────────────────────────────────
    // GeoPoints balances are owned by Cloud Functions for high-value operations.
    // Client-side rules block the most obvious attacks; CF owns all mutations.

    match /dailyTransferTotals/{docId} {
      // Users may only see their own transfer totals.
      allow read:  if signedIn() && resource.data.get('uid', '') == uid();
      allow write: if isAdmin();
    }
    match /pointEarnRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.get('userId', '') == uid() || isAdmin());
      allow create: if signedIn()
        && request.resource.data.get('userId', '') == uid()
        // New requests must start as pending; CF processes them.
        && request.resource.data.get('status', '') == 'pending';
      allow update, delete: if isAdmin();
    }
    match /pointTransactions/{transactionId} {
      // Users can read only transactions they participated in.
      allow read: if signedIn()
        && (uid() in resource.data.participantIds || isAdmin());
      // create/update/delete are admin-only — wallet-doc is the client source of truth.
      // P2P transfers use pointGifts; spendPoints/redeemReward write users/{uid}/private/wallet.
      allow create, update, delete: if isAdmin();
    }

    // ── REWARDS ───────────────────────────────────────────────────────────────

    match /rewards/{rewardId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Admins may change anything.
      // Regular users may decrement quantityRemaining OR stock by exactly 1 when
      // redeeming a reward — all other fields stay unchanged, and only when
      // stock is available.  This keeps the redeem runTransaction working on
      // the Spark plan without Cloud Functions.
      // Both field names are supported because the admin UI writes `stock` while
      // the original schema used `quantityRemaining`.
      // Stock may only be decremented as part of an actual redemption. Rules
      // cannot see the other half of a transaction, so the decrement is now
      // admin-only (the redeem flow belongs in a Cloud Function); leaving it
      // open let any signed-in user drain a reward in a loop without ever
      // producing a coupon.
      allow update: if isAdmin();
    }
    match /rewardCoupons/{couponId} {
      allow read: if signedIn()
        && (resource.data.get('userId',          '') == uid()
            || resource.data.get('businessOwnerId','') == uid()
            || isAdmin());
      // Coupons are issued by the redeemReward Cloud Function after it charged
      // the points; a client must never mint one for itself.
      allow create: if isAdmin();
      // Only the business owner of the reward may mark a coupon used (active → used).
      // Customers cannot self-mark — prevents fraudulent "I already used it" claims.
      // Immutable fields (userId, businessOwnerId, rewardId, code, pointPrice) cannot change.
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.get('businessOwnerId','') == uid()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'usedAt', 'usedBy', 'updatedAt'])
            && request.resource.data.get('status', '') == 'used'
            && resource.data.get('status', '') == 'active');
      allow delete: if isAdmin();
    }
    match /pointGifts/{giftId} {
      allow read: if signedIn()
        && (resource.data.get('fromUserId','') == uid()
            || resource.data.get('toUserId','')   == uid()
            || isAdmin());
      allow create: if signedIn()
        && request.resource.data.get('fromUserId','') == uid()
        && request.resource.data.get('toUserId','')   != uid()
        && request.resource.data.get('status','')     == 'pending'
        && request.resource.data.get('amount', 0)     >  0;
      // Only the recipient may claim (status: pending → claimed).
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.get('toUserId','')   == uid()
            && resource.data.get('status','')     == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','claimedAt'])
            && request.resource.data.get('status','') == 'claimed');
      allow delete: if isAdmin();
    }
    match /rewardClaims/{claimId} {
      allow create: if signedIn()
        && (request.resource.data.get('userId', '') == uid()
            || request.resource.data.get('uid',   '') == uid());
      allow read, update, delete: if isAdmin()
        || (signedIn()
            && (resource.data.get('userId', '') == uid()
                || resource.data.get('uid',   '') == uid()));
    }
    // userRewards are awarded by Cloud Functions; users cannot create their own.
    match /userRewards/{userRewardId} {
      allow read: if signedIn()
        && (resource.data.get('userId', '') == uid() || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ── SAFETY & MODERATION ───────────────────────────────────────────────────

    // Reports: created once by a signed-in user; immutable after that.
    // Status transitions are admin-only (prevents reporter manipulation).
    // Reporters cannot read their own report after submission.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
             'reporterId', 'targetType', 'targetId', 'reason', 'status', 'createdAt'
           ])
        && request.resource.data.get('reporterId', '') == uid()
        // Status must be pending on creation; admin sets resolution.
        && request.resource.data.get('status', '') == 'pending';
      allow read, update, delete: if isAdmin();
    }

    match /hiddenPosts/{hiddenId} {
      allow read: if signedIn()
        && (resource.data.get('userId', '') == uid() || isAdmin());
      allow create: if signedIn() && request.resource.data.get('userId', '') == uid();
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('userId', '') == uid());
    }

    // The client checks exact block documents before comments/messages, e.g.
    // blockedUsers/{postOwnerId}_{currentUserId}. Firestore also applies rules
    // to non-existent docs; a resource.data-based read rule denies those reads
    // before the app can learn "not blocked". For this MVP we allow signed-in
    // users to read block records, while writes stay owner-only and immutable.
    match /blockedUsers/{blockId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.get('blockerId', '') == uid()
        // Users may not block themselves
        && request.resource.data.get('blockedId', '') != uid();
      // Immutable after creation.
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('blockerId', '') == uid());
    }

    match /mutedUsers/{muteId} {
      allow read: if signedIn()
        && (resource.data.get('muterId', '') == uid() || isAdmin());
      allow create: if signedIn() && request.resource.data.get('muterId', '') == uid();
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('muterId', '') == uid());
    }

    // Moderation action log: strictly admin-only (audit trail of decisions).
    match /moderationActions/{actionId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Top-level userBadges collection (display/feed use).
    // Owner may create with field restrictions; updates are admin-only.
    match /userBadges/{badgeId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.get('userId', '') == uid()
        && !request.resource.data.keys().hasAny(['adminGranted', 'special', 'grantedBy']);
      allow update, delete: if isAdmin();
    }

    // ── ADMIN-ONLY COLLECTIONS ────────────────────────────────────────────────

    match /admin/{docId}              { allow read, write: if isAdmin(); }
    match /badges/{badgeId}           { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /challenges/{docId}         { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /services/{docId}           { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /realEstateListings/{docId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /learningItems/{docId}      { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /creators/{docId}           { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /liveActivity/{docId}       { allow read: if true; allow create, update, delete: if isAdmin(); }

    // ── USER-GENERATED CONTENT COLLECTIONS ───────────────────────────────────

    match /collections/{collectionId} { allow read: if true; allow create: if newOwnerMatches(); allow update, delete: if isAdmin() || existingOwnerMatches(); }
    match /routes/{routeId}            { allow read: if true; allow create: if newOwnerMatches(); allow update, delete: if isAdmin() || existingOwnerMatches(); }

    // ── MARKETPLACE ───────────────────────────────────────────────────────────
    match /marketplace/{itemId} {
      allow read: if true;
      allow create: if newOwnerMatches()
        && request.resource.data.get('title', '') != ''
        && request.resource.data.get('status', '') == 'active';
      allow update: if isAdmin() || existingOwnerMatches();
      allow delete: if isAdmin() || existingOwnerMatches();
    }

    // ── UI STATE & FLAGS ──────────────────────────────────────────────────────

    match /userUiState/{userId} {
      // Document ID is the user's UID — owner-only access.
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /adminFlags/{flagId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── ANALYTICS ─────────────────────────────────────────────────────────────
    // Design: signed-in users write (client-side telemetry), admins read.
    // Unauthenticated requests are always denied — no anonymous tracking.
    // uid fields in error/upload docs must match the caller (no faking errors
    // for another user). Presence docs are owner-only with field validation.

    // Daily aggregate counters (pageViews, searches, events, errors — keyed
    // analytics/{subcol}/daily/{YYYY-MM-DD}).
    match /analytics/{subcol}/daily/{dateDoc} {
      allow read: if isAdmin();
      // Counters only, and only upward: an unvalidated write let any user
      // replace a day's analytics with anything.
      allow create: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['count', 'total', 'updatedAt', 'items', 'byPage', 'byTerm']);
      allow delete: if isAdmin();
    }

    // Presence heartbeats: owner-only with mandatory field validation.
    match /analytics/presence/users/{userId} {
      allow read: if isAdmin();
      allow create, update: if isOwner(userId)
        // uid field must match the document ID (the user's uid)
        && request.resource.data.get('uid',  '') == userId
        && request.resource.data.get('page', '') is string
        && request.resource.data.get('page', '').size() > 0
        && request.resource.data.get('page', '').size() < 100;
    }

    // JS error log: any signed-in user may append (self-reporting).
    // uid field if present must match caller — prevents spoofing another
    // user's identity in an error report.
    match /analytics/errors/log/{docId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('page',    '') is string
        && (request.resource.data.get('uid', '') == ''
            || request.resource.data.get('uid', '') == uid());
    }

    // Upload failure log — same uid constraint as errors.
    match /analytics/uploads/failures/{docId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.get('type', '') is string
        && request.resource.data.get('page', '') is string
        && (request.resource.data.get('uid', '') == ''
            || request.resource.data.get('uid', '') == uid());
    }

    // Performance samples: aggregate, no personal data.
    match /analytics/performance/pages/{pageDoc} {
      allow read: if isAdmin();
      allow create, update: if signedIn();
    }

    // ── PAYMENTS & MARKETPLACE ────────────────────────────────────────────────

    // Support requests from the in-app form. Guests may write too (people who
    // cannot sign in still need help), but only this exact shape.
    match /tickets/{docId} {
      allow create: if (newOwnerMatches() || (!signedIn() && request.resource.data.get('userId', '') == ''))
        && request.resource.data.keys().hasOnly(['userId', 'name', 'email', 'category', 'subject', 'message', 'status', 'page', 'lang', 'createdAt'])
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('message', '').size() >= 10
        && request.resource.data.get('message', '').size() <= 4000
        && request.resource.data.get('subject', '') is string
        && request.resource.data.get('subject', '').size() <= 200
        && request.resource.data.get('email', '') is string
        && request.resource.data.get('email', '').size() <= 200
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('category', '') in ['help', 'bug', 'account', 'account_deletion', 'business', 'report', 'other'];
      allow read, update, delete: if isAdmin() || existingOwnerMatches();
    }
    // Payments are written by the Cloudflare Worker (runs as admin); users
    // may read their own payment records only.
    match /payments/{paymentId}    { allow read: if isAdmin() || existingOwnerMatches(); allow create, update, delete: if isAdmin(); }
    match /eventTickets/{ticketId} { allow read: if isAdmin() || existingOwnerMatches(); allow create, update, delete: if isAdmin(); }
    match /campaigns/{docId}       { allow read: if true; allow create: if newOwnerMatches(); allow update, delete: if isAdmin() || existingOwnerMatches(); }
    match /collabOffers/{docId}    { allow create: if newOwnerMatches(); allow read, update, delete: if isAdmin() || existingOwnerMatches(); }
    match /serviceRequests/{docId} { allow create: if newOwnerMatches(); allow read, update, delete: if isAdmin() || existingOwnerMatches(); }
    match /lessonBookings/{docId}  { allow create: if newOwnerMatches(); allow read, update, delete: if isAdmin() || existingOwnerMatches(); }

    // ── SAVED BUSINESSES ─────────────────────────────────────────────────────
    // Document ID convention: {userId}_{businessId}
    match /savedBusinesses/{saveId} {
      allow read: if signedIn()
        && (resource == null
            || resource.data.get('userId', '') == uid()
            || resource.data.get('uid', '') == uid()
            || isAdmin());
      allow create: if signedIn()
        && request.resource.data.get('userId', '') == uid()
        && request.resource.data.get('businessId', '') is string;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.get('userId', '') == uid() || isAdmin());
    }

    // ── INVITES & REFERRALS ───────────────────────────────────────────────────
    // Invite codes are created by users and updated only to increment the use
    // counter. The createdBy and code fields are immutable after creation.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.get('createdBy', '') == uid()
        && request.resource.data.get('uses', -1) == 0;
      // Only the use counter and lastUsedAt timestamp may change.
      allow update: if signedIn()
        && resource.data.get('createdBy', '') != ''
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['uses', 'lastUsedAt']);
      allow delete: if isAdmin();
    }

    // ── VIDEO PLATFORM ───────────────────────────────────────────────────────

    // True when caller is a full admin OR listed in adminConfig/videoMods.uids.
    function isVideoMod() {
      return isAdmin()
        || (signedIn()
            && exists(/databases/$(database)/documents/adminConfig/videoMods)
            && uid() in get(/databases/$(database)/documents/adminConfig/videoMods).data.get('uids', []));
    }

    // Any signed-in user may update video engagement counters (client-side MVP).
    function onlyVideoCountersChanged() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likeCount', 'viewCount', 'commentCount', 'updatedAt'])
        // Posts already clamp each counter to +/-1 per write; videos did not,
        // so a single write could set likeCount to any number.
        && counterDelta('likeCount')
        && counterDelta('viewCount')
        && counterDelta('commentCount');
    }

    // Fields a creator may safely edit after publishing.
    function onlySafeVideoFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title', 'description', 'category', 'city', 'tags',
        'placeId', 'placeName', 'businessId', 'businessName', 'updatedAt'
      ]);
    }

    // Status transitions allowed to video moderators.
    function onlyVideoStatusChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt'])
        && request.resource.data.get('status', '') in ['active', 'hidden', 'removed'];
    }

    function validVideoChannel(data) {
      let channelId = data.get('channelId', null);
      return channelId == null || channelId == ''
        || (channelId is string && channelId.matches('^[A-Za-z0-9_-]{1,150}$')
          && exists(/databases/$(database)/documents/channels/$(channelId))
          && get(/databases/$(database)/documents/channels/$(channelId)).data.get('ownerId', '') == uid());
    }

    match /videos/{videoId} {
      // Public read: watch page needs to load hidden/removed docs to show
      // the "unavailable" message; client-side code filters the feed.
      allow read: if true;

      // Create: must claim own authorId; status must start 'active'.
      allow create: if signedIn()
        && request.resource.data.get('authorId', '') == uid()
        && request.resource.data.get('status', 'active') == 'active'
        && validVideoChannel(request.resource.data);

      // Update: counters (any signed-in), safe edits (creator), status (mod), all (admin).
      allow update: if isAdmin()
        || onlyVideoCountersChanged()
        || (existingOwnerMatches() && onlySafeVideoFieldsChanged())
        || (isVideoMod() && onlyVideoStatusChanged());

      // Hard delete: creator or admin (soft-delete via status preferred).
      allow delete: if isAdmin() || existingOwnerMatches();

      // Likes: doc ID = liker's UID.
      match /likes/{likeUserId} {
        allow read: if true;
        allow create, update: if isOwner(likeUserId);
        allow delete: if isAdmin() || isOwner(likeUserId);
      }

      // Comments: signed-in users create; authors edit; video owner/admin delete.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.get('authorId', '') == uid()
          && validContentIdentity(request.resource.data)
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() > 0;
        allow update: if isAdmin()
          || (existingOwnerMatches() && contentIdentityUnchanged() && onlyCommentTextChanged())
          || onlyCommentCountersChanged();
        // Comment author OR video owner OR admin.
        allow delete: if isAdmin()
          || existingOwnerMatches()
          || (signedIn()
              && get(/databases/$(database)/documents/videos/$(videoId))
                   .data.get('authorId', '') == uid());
      }

      // Reactions: doc ID = reactor's UID.
      match /reactions/{rxUserId} {
        allow read: if true;
        allow create, update: if isOwner(rxUserId)
          && request.resource.data.get('uid', rxUserId) == uid();
        allow delete: if isAdmin() || isOwner(rxUserId);
      }
    }

    // ── VIDEO REPORTS ─────────────────────────────────────────────────────────
    // Doc ID: {reporterUid}_{videoId} — one report per user per video.
    match /videoReports/{reportId} {
      // Only video mods and admins may read reports.
      allow read: if isVideoMod();
      // Any signed-in user may file a report; reporterUid must match caller.
      allow create: if signedIn()
        && request.resource.data.get('reporterUid', '') == uid()
        && request.resource.data.get('status',      '') == 'pending'
        && request.resource.data.get('videoId',     '') is string
        && request.resource.data.get('reason',      '') is string;
      // Mods may update status only; reporters cannot edit.
      allow update: if isVideoMod()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'resolvedBy', 'resolvedAt']);
      // Only admins may delete (audit trail).
      allow delete: if isAdmin();
    }

    // ── SAVED VIDEOS ──────────────────────────────────────────────────────────
    // Doc ID: {uid}_video_{videoId}
    match /savedVideos/{saveId} {
      allow read: if signedIn()
        && (resource.data.get('userId', '') == uid() || isAdmin());
      allow create: if signedIn()
        && request.resource.data.get('userId',  '') == uid()
        && request.resource.data.get('videoId', '') is string;
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('userId', '') == uid());
    }

    // ── ADMIN CONFIG ──────────────────────────────────────────────────────────
    // Contains documents like videoMods.uids for video moderator UIDs.
    // Signed-in users may read (needed for client-side isVideoMod checks).
    // Only admins may write.
    match /adminConfig/{docId} {
      allow read:                   if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── CHANNELS ──────────────────────────────────────────────────────────────
    // Any signed-in user can create a channel (ownerId must match their uid).
    // Anyone can read. Only the owner or admin can update/delete the channel doc.
    match /channels/{channelId} {
      allow read:   if true;
      allow create: if signedIn()
        && request.resource.data.get('ownerId', '') == uid()
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() > 0
        && request.resource.data.get('name', '').size() <= 80;
      allow update: if (isOwner(resource.data.get('ownerId', ''))
          && request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '')
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('name', '').size() > 0
          && request.resource.data.get('name', '').size() <= 80)
        || isAdmin()
        || (signedIn() && onlyChannelCountersChanged());
      allow delete: if isOwner(resource.data.get('ownerId', '')) || isAdmin();

      // Subscriber sub-collection: signed-in users write only their own doc.
      match /subscribers/{subUid} {
        allow read:             if true;
        allow create, delete:   if isOwner(subUid);
      }

      // Playlists sub-collection: public read, owner write.
      match /playlists/{playlistId} {
        allow read:   if true;
        allow create, update, delete: if isOwner(get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId) || isAdmin();
      }

      // Channel posts (Community tab) sub-collection.
      match /posts/{postId} {
        allow read:   if true;
        allow create, update, delete: if isOwner(get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId) || isAdmin();
      }
    }

    // ── CALLS (WebRTC signaling) ──────────────────────────────────────────────
    match /calls/{callId} {
      allow create: if signedIn() && request.resource.data.callerId == uid();
      allow read:   if signedIn() && (resource.data.callerId == uid() || resource.data.calleeId == uid());
      allow update: if signedIn() && (resource.data.callerId == uid() || resource.data.calleeId == uid());
      allow delete: if false;

      match /callerCandidates/{cid} {
        allow read:   if signedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == uid()
                                     || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == uid());
        allow create: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == uid();
        allow delete: if false;
      }
      match /calleeCandidates/{cid} {
        allow read:   if signedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == uid()
                                     || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == uid());
        allow create: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == uid();
        allow delete: if false;
      }
      match /messages/{msgId} {
        allow read:   if signedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == uid()
                                     || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == uid());
        allow create: if signedIn() && request.resource.data.uid == uid()
                                    && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == uid()
                                     || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == uid());
        allow delete: if false;
      }
    }

    // ── GROUP CALLS (WebRTC mesh signaling) ──────────────────────────────────

    // True when the caller is listed in a group call's participantIds.
    function isGroupCallParticipant(callId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groupCalls/$(callId))
        && uid() in get(/databases/$(database)/documents/groupCalls/$(callId))
                      .data.get('participantIds', []);
    }

    match /groupCalls/{callId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.get('hostUid', '') == uid();
      allow update: if isGroupCallParticipant(callId)
        || (signedIn() && resource.data.get('hostUid', '') == uid());
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if signedIn();
        allow create, update: if isOwner(memberUid);
        allow delete: if false;
      }
      match /signals/{pairId} {
        allow read: if signedIn();
        allow create, update: if isGroupCallParticipant(callId);
        allow delete: if false;
      }
      match /ice/{pairDoc}/candidates/{candId} {
        allow read: if isGroupCallParticipant(callId);
        allow create: if isGroupCallParticipant(callId);
        allow delete: if false;
      }
    }

    // ── LIVE STREAMING (WebRTC P2P broadcast) ────────────────────────────────

    match /livestreams/{streamId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.get('hostUid', '') == uid();
      allow update: if signedIn()
        && (resource.data.get('hostUid', '') == uid()
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['viewerCount']));
      allow delete: if false;

      match /viewers/{viewerUid} {
        allow read: if signedIn();
        allow create: if isOwner(viewerUid);
        allow update: if isOwner(viewerUid)
          || (signedIn() && get(/databases/$(database)/documents/livestreams/$(streamId))
                              .data.get('hostUid', '') == uid());
        allow delete: if false;
      }
      match /bcCandidates/{viewerUid}/candidates/{candId} {
        allow read: if isOwner(viewerUid);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/livestreams/$(streamId))
               .data.get('hostUid', '') == uid();
        allow delete: if false;
      }
      match /vcCandidates/{viewerUid}/candidates/{candId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/livestreams/$(streamId))
               .data.get('hostUid', '') == uid();
        allow create: if isOwner(viewerUid);
        allow delete: if false;
      }
    }

    // ── REFERRALS ─────────────────────────────────────────────────────────────
    match /referrals/{referralId} {
      // Owner (referrer or referred) can read their referral; signed-in can query by referrerCode for stats.
      // Was `|| true`, which collapsed the whole condition to signedIn() and
      // published the entire referral graph. Aggregate stats belong in a
      // counter document (meta/referralStats), not in a blanket read.
      allow read: if signedIn()
        && (resource.data.get('referrerId','') == uid()
            || resource.data.get('referredId','') == uid()
            || isAdmin());
      allow create: if signedIn()
        && request.resource.data.get('referredId','') == uid()
        && request.resource.data.referrerId != uid(); // no self-referral
      allow update, delete: if false;
    }

    // ── META (read-only counters + earlyAdopter) ─────────────────────────────
    match /meta/{docId} {
      // Anyone can read meta docs (counts, limits, public config).
      allow read: if true;
      // earlyAdopter counter: signed-in users may increment count by exactly 1
      // or create the initial doc (when it doesn't exist yet).
      allow create: if signedIn()
        && docId == 'earlyAdopter'
        && request.resource.data.count == 1
        && request.resource.data.limit == 100;
      allow update: if signedIn()
        && docId == 'earlyAdopter'
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.limit == resource.data.limit
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']);
    }

    // ── DENY-ALL FALLBACK ─────────────────────────────────────────────────────
    // Any collection not explicitly listed above is blocked.
    // This prevents accidental exposure when new collections are added without
    // corresponding rules.
    match /{document=**} { allow read, write: if false; }
  }
}
