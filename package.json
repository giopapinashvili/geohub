{
  "name": "geohub",
  "version": "1.0.0",
  "private": true,
  "description": "GeoHub — Georgian social and discovery platform (Vite + Preact app in web/, Firebase backend).",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "vite build",
    "build:emulator": "vite build --mode emulator",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-geohub",
    "seed": "node web/tools/seed-emulator.mjs",
    "i18n:check": "node web/tools/check-i18n.mjs",
    "test:e2e": "node web/tools/e2e-flows.mjs && node web/tools/e2e-call.mjs && node web/tools/sweep.mjs --as=nino",
    "lint": "eslint web/src"
  },
  "dependencies": {
    "@fontsource/firago": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "firebase": "^12.19.0",
    "maplibre-gl": "^5.24.0",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.60.0",
    "@preact/preset-vite": "^2.10.6",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "eslint": "^9.39.5",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^15.31.0",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "playwright": "^1.60.0",
    "preact-render-to-string": "^6.7.0",
    "vite": "^7.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giopapinashvili/geohub.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/giopapinashvili/geohub/issues"
  },
  "homepage": "https://github.com/giopapinashvili/geohub#readme"
}
