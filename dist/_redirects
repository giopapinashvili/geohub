/explore.html        /places                    301
/place-feed          /places?tab=updates        301
/place-feed.html     /places?tab=updates        301
/place-updates       /places?tab=updates        301
/place-updates.html  /places?tab=updates        301
/reviews             /places?tab=reviews        301
/reviews.html        /places?tab=reviews        301

# ── Marketplace: products · services → marketplace ──
/products            /marketplace?tab=products  301
/products.html       /marketplace?tab=products  301
/services            /marketplace?tab=services  301
/services.html       /marketplace?tab=services  301

