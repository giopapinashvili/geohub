# Cloudflare Pages response headers for the GeoHub app (web/).
# The CSP lists exactly what the app loads:
#   script  — own bundle; Google's auth helper (apis.google.com) for social sign-in
#   connect — Firebase (Auth, Firestore, FCM), Cloudinary uploads, the payments
#             worker, Carto map tiles and styles
#   img     — https: because user content comes from many hosts
#             (Cloudinary, Google avatars, YouTube thumbnails, event images …)
#   frame   — YouTube players and the Firebase auth iframe
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), payment=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: https://res.cloudinary.com https://firebasestorage.googleapis.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://api.cloudinary.com https://res.cloudinary.com https://geohub-payments.gio-papinashvili20-bd3.workers.dev https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com https://tiles.mapterhorn.com; worker-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://geohub-main.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned map directories and content-hashed place datasets only. Never use
# this rule for HTML, account data, Firestore responses or mutable manifests.
/map-tiles/*
  Cache-Control: public, max-age=31536000, immutable

/place-data/places-*
  Cache-Control: public, max-age=31536000, immutable

/place-data/overview-*
  Cache-Control: public, max-age=31536000, immutable

/place-data/lookup-*
  Cache-Control: public, max-age=31536000, immutable

/place-data/search-index-*
  Cache-Control: public, max-age=31536000, immutable

/place-data/manifest.json
  Cache-Control: no-cache

/catalog-data/*
  Cache-Control: public, max-age=3600

/catalog-data/index.json
  Cache-Control: no-cache

/catalog-data/services-index.json
  Cache-Control: no-cache

/catalog-data/search/manifest.json
  Cache-Control: no-cache

/place-media/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/place-media/credits.json
  Cache-Control: no-cache

/demo-media/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/demo-media/credits.json
  Cache-Control: no-cache

/map-data/*
  Cache-Control: public, max-age=86400

/map-brands/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=604800

/manifest.webmanifest
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/firebase-messaging-sw.js
  Cache-Control: no-cache

/theme-init.js
  Cache-Control: no-cache

/admin*
  X-Robots-Tag: noindex
